# cp secrets.env.example secrets.env && chmod 600 secrets.env
# All optional — tabs whose token is missing degrade to a hint instead of data.

# Vercel: https://vercel.com/account/settings/tokens (scope: full account)
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Sentry: Settings → API Keys → New Internal Key (project:read, event:read)
SENTRY_TOKEN=
SENTRY_ORG=
# SENTRY_URL=https://sentry.selfhosted.example   # uncomment for self-hosted

# PostHog: Settings → Personal API Keys
POSTHOG_KEY=

# GitHub uses the `gh` CLI auth (gh auth login) — no token needed here.
